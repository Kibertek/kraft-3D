APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# PostgreSQL must listen only on the server/private interface in production.
DATABASE_URL=postgresql://kraft3d:change_me@127.0.0.1:5432/kraft3d

# Frontend origins allowed to send credentialed requests.
CORS_ORIGINS=http://localhost:5173

# Session cookie settings.
SESSION_COOKIE_NAME=kraft3d_session
SESSION_TTL_HOURS=12
COOKIE_SECURE=false

# First-run administrator bootstrap. Never commit the real values.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
